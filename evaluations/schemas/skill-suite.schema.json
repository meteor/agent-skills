{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meteor/agent-skills/evaluations/schemas/skill-suite.schema.json",
  "title": "Meteor skill behavior suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "description", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "description": { "type": "string", "minLength": 16, "maxLength": 300 },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "meteorContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release"],
      "properties": {
        "release": { "type": "string", "minLength": 1, "maxLength": 80 },
        "packages": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9@][a-z0-9:@./_-]*$" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
        "text": { "type": "string", "minLength": 8, "maxLength": 300 },
        "evidence": { "enum": ["response", "files", "command"] },
        "command": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "evidence": { "const": "command" } }, "required": ["evidence"] },
          "then": { "required": ["command"] },
          "else": { "not": { "required": ["command"] } }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case_ref", "mode", "prompt", "meteor", "assertions", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
        "case_ref": { "type": "string", "pattern": "^Case [1-9][0-9]*: .+$", "maxLength": 180 },
        "mode": { "enum": ["advisory", "workspace"] },
        "prompt": { "type": "string", "minLength": 12, "maxLength": 2000 },
        "meteor": { "$ref": "#/$defs/meteorContext" },
        "fixture": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]*/)?(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$",
          "maxLength": 240
        },
        "assertions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["representative", "boundary", "failure", "regression", "version"] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "workspace" } }, "required": ["mode"] },
          "then": { "required": ["fixture"] },
          "else": { "not": { "required": ["fixture"] } }
        }
      ]
    }
  }
}
