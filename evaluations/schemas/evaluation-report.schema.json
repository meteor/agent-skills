{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meteor/agent-skills/evaluations/schemas/evaluation-report.schema.json",
  "title": "Meteor skill evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "mode",
    "suite",
    "suite_snapshot",
    "suite_sha256",
    "skill_version",
    "agent_skills",
    "meteor",
    "environment",
    "claims",
    "runs",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["smoke", "comparison"] },
    "suite": { "type": "string", "pattern": "^evaluations/skills/[a-z0-9-]+/cases\\.json$" },
    "suite_snapshot": { "type": "string", "pattern": "^evaluations/snapshots/[a-f0-9]{64}\\.json$" },
    "suite_sha256": { "$ref": "#/$defs/digest" },
    "skill_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "agent_skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty"],
      "properties": {
        "revision": { "type": "string", "minLength": 7, "maxLength": 80 },
        "dirty": { "type": "boolean" }
      }
    },
    "meteor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "revision", "release", "dirty"],
      "properties": {
        "remote": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "minLength": 7, "maxLength": 80 },
        "release": { "type": "string", "minLength": 1, "maxLength": 80 },
        "dirty": { "type": "boolean" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "model", "platform"],
      "properties": {
        "client": { "type": "string", "minLength": 1, "maxLength": 120 },
        "model": { "type": "string", "minLength": 1, "maxLength": 120 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_skill_revision": { "type": "string", "minLength": 7, "maxLength": 80 }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["behavior", "reliability", "time", "tokens"] }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "notes"],
      "properties": {
        "classification": { "enum": ["no-gap", "skill-gap", "evaluation-gap", "harness-gap", "inconclusive"] },
        "notes": { "type": "string", "minLength": 8, "maxLength": 2000 }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assertionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "passed": { "type": "boolean" },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "repetition", "condition", "fixture_sha256", "status", "assertions"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "repetition": { "type": "integer", "minimum": 1, "maximum": 20 },
        "condition": { "enum": ["current-skill", "without-skill", "previous-skill"] },
        "fixture_sha256": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["pass", "fail", "error"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "assertions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/assertionResult" }
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^evaluations/\\.work/" }
        }
      }
    }
  }
}
