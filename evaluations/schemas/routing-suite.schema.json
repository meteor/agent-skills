{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meteor/agent-skills/evaluations/schemas/routing-suite.schema.json",
  "title": "Meteor skill routing suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "description", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "description": { "type": "string", "minLength": 16, "maxLength": 300 },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "skillName": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
        "prompt": { "type": "string", "minLength": 12, "maxLength": 1200 },
        "meteor": { "type": "string", "minLength": 1, "maxLength": 80 },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "secondary", "forbidden", "behavior"],
          "properties": {
            "primary": { "$ref": "#/$defs/skillName" },
            "secondary": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/skillName" }
            },
            "forbidden": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/skillName" }
            },
            "behavior": { "type": "string", "minLength": 12, "maxLength": 400 }
          }
        }
      }
    }
  }
}
